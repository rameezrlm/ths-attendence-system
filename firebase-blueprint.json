{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "IT Lab Student registered in the attendance system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record for a student on a specific date",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "date": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["present", "absent", "late", "early_left"]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "studentName", "date", "status"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Lab instructor with login credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of all enrolled students in the IT lab"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Collection of daily attendance records keyed by studentId_date"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Collection of teachers added by Admin"
    }
  }
}
