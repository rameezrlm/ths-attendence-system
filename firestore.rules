rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Access rule: allow authenticated users or time-bounded access
    function isAllowed() {
      return request.auth != null || request.time < timestamp.date(2026, 12, 31);
    }

    // Students collection: Only lab teachers and admins can view and manage students
    match /students/{studentId} {
      allow read, write: if isAllowed();
    }

    // Attendance records: One record per student per date
    match /attendance/{attendanceId} {
      allow read, write: if isAllowed();
    }

    // Teachers / Instructors managed by Admin
    match /teachers/{teacherId} {
      allow read, write: if isAllowed();
    }

    // Gradebook sections (Quiz, Assignment, Project, ...)
    match /gradeSections/{sectionId} {
      allow read, write: if isAllowed();
    }

    // Individual assessments inside a section (Quiz 1, Quiz 2, ...)
    match /gradeAssessments/{assessmentId} {
      allow read, write: if isAllowed();
    }

    // Student marks keyed by assessmentId_studentId
    match /gradeMarks/{markId} {
      allow read, write: if isAllowed();
    }

    // Student tickets reviewed by teachers
    match /tickets/{ticketId} {
      allow read, write: if isAllowed();
    }

    // Assignment files uploaded by teachers for students to download
    match /assignments/{assignmentId} {
      allow read, write: if isAllowed();
    }

    match /assignmentSubmissions/{submissionId} {
      allow read, write: if isAllowed();
    }

    match /assignmentFiles/{fileId} {
      allow read, write: if isAllowed();
      match /chunks/{chunkId} {
        allow read, write: if isAllowed();
      }
    }

    match /announcements/{announcementId} {
      allow read, write: if isAllowed();
    }

    match /labClasses/{classId} {
      allow read, write: if isAllowed();
    }
  }
}
